configuration {
  modi: "drun,run,window";
  icon-theme: "Iosevka";
  show-icons: false;
  terminal: "alacritty";
  drun-display-format: "{icon} {name}";
  location: 0;
  disable-history: false;
  hide-scrollbar: true;
  display-drun: "> ";
}

@theme "/dev/null"

* {
  bg: #24182c;
  bg-alt: #14081c;
  fg: #d4ced9;

  background-color: @bg;
  border: 0;

  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 35%;
}

element {
  padding: 8px 0px;
  width: 80%;
  text-color: @fg;
}

element selected {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 16px;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
  horizontal-align: 0.5;
}

inputbar {
  margin: 8px 8px 4px 8px;
  border-radius: 16px;
  children: [entry];
}

entry {
  background-color: @bg;
  padding: 12px;
  text-color: @fg;
  horizontal-align: 0.5;
}

listview {
  margin: 4px 8px 12px 8px;
  background-color: @bg;
  columns: 1;
  lines: 5;
}

mainbox {
  background-color: @bg;
  children: [inputbar, listview];
}
